# .env
FLASK_ENV=production
SECRET_KEY=replace-with-strong-secret
TZ=Asia/Kolkata

# Mongo
MONGO_INITDB_ROOT_USERNAME=animalkb_admin
MONGO_INITDB_ROOT_PASSWORD=verysecurepassword
MONGO_DB=animalkb
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=admin

# Redis (Celery broker & result backend)
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/1

# Image tags (change to your pushed tags if needed)
WEB_IMAGE=rbdockerhuub/animalkb-web:latest
WORKER_IMAGE=rbdockerhuub/animalkb-worker:latest
BEAT_IMAGE=rbdockerhuub/animalkb-beat:latest

# App & ports
WEB_INTERNAL_PORT=8000
DOMAIN=animalkb.ivutechnxt.com
